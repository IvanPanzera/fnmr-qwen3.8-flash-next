data = [59, 26, 19, 8, 25, 5, 88, 35, 62, 41, 44, 81, 74, 26, 31, 53, 58, 21, 12, 23, 63, 85]\narr = np.array(data)\n\n# Calcolo statistiche robuste\nmediana = np.median(arr)\nq1 = np.percentile(arr, 25)\nq3 = np.percentile(arr, 75)\niqr = q3 - q1\n\n# Soglie (regola 1.5 * IQR)\nlimite_inf = q1 - 1.5 * iqr\nlimite_sup = q3 + 1.5 * iqr\n\n# Identificazione outlier\noutliers = [x for x in arr if x < limite_inf or x > limite_sup]\n\nprint(f\"Soglia inferiore: {limite_inf:.2f}\")\nprint(f\"Soglia superiore: {limite_sup:.2f}\")\nprint(f\"Outlier individuati: {outliers}\")\n```<|im_end|>","answer_translation":{"method":"literal structured/code response","service":"Google Translate","translated_date":"2026-10-16","source_sha256":"5968c5d52ecc4efc37d90233e20f11a976136d8a0427ed4366b90380e04a4113","sha256":"5968c5d52ecc4efc37d90233e20f11a976136d8a0427ed4366b90380e04a4113","used_for_inference":false,"editorial_changes":[]},"answer_literal_glossary":[{"original":"Calcolo statistiche robuste","english":"Compute robust statistics"},{"original":"Soglie (regola 1.5 * IQR)","english":"Thresholds (1.5 * IQR rule)"},{"original":"Identificazione outlier","english":"Outlier identification"}]}